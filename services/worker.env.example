# Copy to services/worker.env on the instance and fill in. Never commit the real file.
#
# The worker runs the same pipeline code as the serverless functions, so it needs the same
# credentials they do.

MONGODB_URI=mongodb+srv://.../ganime?retryWrites=true
# The DATABASE NAME, lowercased (db.js derives it from this, not from the URI path). Without
# it the worker cannot connect at all.
VITE_APP_DISPLAY_NAME=Ganime
# Selects the database suffix: unset/production -> `ganime`, `qa` -> `ganime-qa`.
NODE_ENV=production
OPENAI_API_KEY=
BUNNY_API_KEY=
VITE_BUNNY_LIBRARY_ID=
BUNNY_PULL_ZONE=
BUNNY_TOKEN_KEY=
VITE_VIDEO_STORAGE=s1

# Where the worker calls back to, and the secret shared with it. Must match the values set
# in Netlify (API_URL is the site; WORKER_SHARED_SECRET is identical on both sides).
API_URL=https://ganime.io
WORKER_SHARED_SECRET=

# Auto-moderation must be ON here even though it is off in the serverless environment: the
# whole point of this instance is to run the scan the functions could not.
MODERATION_ENABLED=true

# Cap ffmpeg to this many threads per job. Uncapped, ONE job saturates every core and the
# other WORKER_CONCURRENCY jobs simply contend with it. Keep FFMPEG_THREADS x
# WORKER_CONCURRENCY at or below the instance's vCPU count.
FFMPEG_THREADS=2
