default_platform(:android)

# Absolute path to the signed AAB produced by `npm run cordova:android:aab`.
AAB = File.expand_path(
  "../platforms/android/app/build/outputs/bundle/release/app-release.aab",
  __dir__,
)

CONFIG_XML = File.expand_path("../config.xml", __dir__)

# --- versionCode automation ---------------------------------------------------
# Highest versionCode already used on Play across all tracks (0 if none/unreachable).
def highest_play_version_code
  %w[production beta alpha internal].flat_map do |t|
    begin
      google_play_track_version_codes(track: t)
    rescue => e
      UI.message("(track '#{t}' not queried: #{e.message})")
      []
    end
  end.map(&:to_i).max || 0
end

# The android-versionCode currently in config.xml (0 if not set).
def config_version_code
  m = File.read(CONFIG_XML).match(/android-versionCode="(\d+)"/)
  m ? m[1].to_i : 0
end

# Write android-versionCode into config.xml (adding the attribute if missing).
def set_config_version_code(code)
  xml = File.read(CONFIG_XML)
  if xml =~ /android-versionCode="\d+"/
    xml.sub!(/android-versionCode="\d+"/, %(android-versionCode="#{code}"))
  else
    xml.sub!(/(<widget\b[^>]*?\bversion="[^"]*")/, %(\\1 android-versionCode="#{code}"))
  end
  File.write(CONFIG_XML, xml)
end

# Next versionCode = one above the max of (what's on Play, what's in config.xml). The
# config.xml floor keeps it monotonic even if Play can't be reached.
def bump_version_code!
  code = [highest_play_version_code, config_version_code].max + 1
  set_config_version_code(code)
  UI.important("Android versionCode → #{code}")
  code
end

# --- iOS / TestFlight ---------------------------------------------------------
IOS_APP_IDENTIFIER = "io.ganime.app"
IOS_WORKSPACE = File.expand_path("../platforms/ios/App.xcworkspace", __dir__)
IOS_OUTPUT_DIR = File.expand_path("../build/ios-appstore", __dir__)
CERTS_DIR = File.expand_path("certs", __dir__)

# FreshRoad's Apple Developer Team ID (needed for distribution signing).
def ios_team_id
  ENV["IOS_TEAM_ID"] || UI.user_error!("Set IOS_TEAM_ID to FreshRoad's Apple Developer Team ID")
end

# App Store Connect API key (App Store Connect → Users and Access → Integrations → keys).
# Uploads to TestFlight without interactive 2FA. Env: ASC_KEY_ID, ASC_ISSUER_ID, and the .p8
# at ASC_KEY_FILEPATH (default fastlane/asc_api_key.p8, gitignored).
def ios_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_FILEPATH"] || File.expand_path("asc_api_key.p8", __dir__),
    duration: 1200,
  )
rescue KeyError => e
  UI.user_error!("Missing App Store Connect API key config (#{e.message}). Set ASC_KEY_ID, ASC_ISSUER_ID and drop the .p8 at fastlane/asc_api_key.p8 (or ASC_KEY_FILEPATH).")
end

# Marketing version (CFBundleShortVersionString) from config.xml's widget version.
def ios_marketing_version
  m = File.read(CONFIG_XML).match(/<widget\b[^>]*?\bversion="([^"]*)"/)
  m ? m[1] : "1.0.0"
end

def config_ios_build_number
  m = File.read(CONFIG_XML).match(/ios-CFBundleVersion="(\d+)"/)
  m ? m[1].to_i : 0
end

# Write ios-CFBundleVersion into config.xml (cordova reads it on `cordova prepare ios`).
def set_config_ios_build_number(n)
  xml = File.read(CONFIG_XML)
  if xml =~ /ios-CFBundleVersion="\d+"/
    xml.sub!(/ios-CFBundleVersion="\d+"/, %(ios-CFBundleVersion="#{n}"))
  else
    xml.sub!(/(<widget\b[^>]*?\bversion="[^"]*")/, %(\\1 ios-CFBundleVersion="#{n}"))
  end
  File.write(CONFIG_XML, xml)
end

# Next build number = one above the max of (latest on TestFlight, what's in config.xml).
def bump_ios_build_number!(api_key)
  latest = begin
    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      version: ios_marketing_version,
      initial_build_number: 0,
    ).to_i
  rescue => e
    UI.message("(TestFlight build number not queried: #{e.message})")
    0
  end
  n = [latest, config_ios_build_number].max + 1
  set_config_ios_build_number(n)
  UI.important("iOS build number → #{n}")
  n
end

# Common options for every Play upload — we only ship the binary; store listing / metadata
# / screenshots are managed by hand in the Play Console.
def play_opts(track, status)
  {
    track: track,
    aab: AAB,
    release_status: status,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true,
  }
end

platform :android do
  desc "Build a signed release AAB via Cordova (auto-bumps versionCode)"
  lane :build do
    bump_version_code!
    sh("cd .. && npm run cordova:android:aab")
  end

  desc "Build, then upload to the Internal testing track (draft by default)"
  lane :internal do |options|
    build
    upload_to_play_store(**play_opts("internal", options[:status] || "draft"))
  end

  desc "Build, then upload to the Closed testing (beta) track"
  lane :beta do |options|
    build
    upload_to_play_store(**play_opts("beta", options[:status] || "draft"))
  end

  desc "Upload the already-built AAB to Internal testing (no rebuild)"
  lane :upload_only do |options|
    upload_to_play_store(**play_opts(options[:track] || "internal", options[:status] || "draft"))
  end

  desc "Verify the Play service-account key can authenticate"
  lane :validate do
    validate_play_store_json_key
  end
end

platform :ios do
  desc "Build a signed release IPA via Cordova (auto-bumps the TestFlight build number)"
  lane :build do
    api_key = ios_api_key
    bump_ios_build_number!(api_key)

    # Distribution signing assets for io.ganime.app. Created via the API — device-independent
    # (App Store archives don't need a registered device, unlike development profiles). cert
    # reuses an installed Apple Distribution cert or creates one; sigh makes the App Store
    # profile. May prompt for keychain access on the first run.
    cert(api_key: api_key, output_path: CERTS_DIR)
    sigh(api_key: api_key, app_identifier: IOS_APP_IDENTIFIER, platform: "ios", output_path: CERTS_DIR)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    sh("cd .. && npm run build:cordova && npx cordova prepare ios")

    # Manual distribution signing on the App target ONLY. Passing signing via global xcargs
    # would also hit the Cordova Swift-package framework targets, which don't support
    # provisioning profiles — so set it in the pbxproj scoped to the "App" target instead.
    update_code_signing_settings(
      path: File.expand_path("../platforms/ios/App.xcodeproj", __dir__),
      use_automatic_signing: false,
      team_id: ios_team_id,
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: IOS_APP_IDENTIFIER,
      build_configurations: ["Release"],
    )

    build_app(
      workspace: IOS_WORKSPACE,
      scheme: "App",
      configuration: "Release",
      # Force iOS — the App scheme also lists a visionOS destination, which xcodebuild would
      # otherwise pick for the archive (and fail: "visionOS is not installed").
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: IOS_OUTPUT_DIR,
      output_name: "Ganime.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ios_team_id,
        provisioningProfiles: { IOS_APP_IDENTIFIER => profile_name },
      },
    )
  end

  desc "Build, then upload to TestFlight (no auto-submit to external testers)"
  lane :beta do
    api_key = ios_api_key
    build
    upload_to_testflight(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Upload the already-built IPA to TestFlight (no rebuild)"
  lane :upload_only do
    upload_to_testflight(
      api_key: ios_api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      ipa: File.expand_path("../build/ios-appstore/Ganime.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Verify the App Store Connect API key can authenticate"
  lane :validate do
    ios_api_key
    UI.success("App Store Connect API key OK")
  end

  # --- App Store listing metadata ---------------------------------------------
  # NOTE: the App Store product-page ICON is not settable here (or anywhere via the API).
  # Since iOS 11 Apple derives it from the 1024x1024 marketing icon inside the uploaded
  # build; deliver's :app_icon option is inert, flagged "Removed after the migration to
  # the new App Store Connect API in June 2020". Ship a build to change the icon.

  PRIVACY_POLICY_URL = "https://ganime.io/privacy.html"

  # Attach an already-uploaded build to the App Store version.
  #
  # This is the step that is easy to miss: `upload_to_testflight` puts a build in
  # TestFlight but does NOT select it for the App Store version, so the version (and the
  # icon ASC shows for the app) keeps pointing at whatever build was selected before.
  # deliver only calls select_build from its submit-for-review path, which would also
  # submit the app — so do it directly here instead.
  #
  #   bundle exec fastlane ios select_build              # newest build
  #   bundle exec fastlane ios select_build build:15     # a specific one
  #
  # Does NOT submit for review; the version stays in Prepare for Submission.
  desc "Select an uploaded build for the App Store version (no review submission)"
  lane :select_build do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: ios_api_key)
    app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
    platform = Spaceship::ConnectAPI::Platform::IOS

    version = app.get_edit_app_store_version(platform: platform)
    UI.user_error!("No editable App Store version (nothing in Prepare for Submission)") unless version

    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 20)
    wanted = options[:build]&.to_s
    build = wanted ? builds.find { |b| b.version.to_s == wanted } : builds.first
    UI.user_error!("Build #{wanted || '(latest)'} not found") unless build
    UI.user_error!("Build #{build.version} is still #{build.processing_state} — wait for VALID") unless build.processing_state == "VALID"

    current = (version.build rescue nil)
    UI.important("Version #{version.version_string}: build #{current&.version || 'NONE'} -> #{build.version}")
    version.select_build(build_id: build.id)
    UI.success("Selected build #{build.version} for #{version.version_string}")
  end

  desc "Show the App Store listing's privacy-policy URL per locale (read-only)"
  # Run this before :metadata to see what would change.
  lane :metadata_show do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: ios_api_key)
    app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
    UI.user_error!("App #{IOS_APP_IDENTIFIER} not found") unless app

    info = app.fetch_edit_app_info || app.fetch_live_app_info
    info.get_app_info_localizations.each do |loc|
      UI.important("#{loc.locale}  privacy_policy_url = #{loc.privacy_policy_url.inspect}")
    end
    UI.message("Target value: #{PRIVACY_POLICY_URL}")
  end

  # Push the privacy-policy URL to every locale the listing already has.
  #
  # Only keys passed here are written: deliver skips any option that is nil
  # (`next unless current` in upload_metadata.rb), so the description, keywords,
  # screenshots and everything else are left untouched. Binary and screenshot
  # uploads are skipped outright, and nothing is submitted for review.
  #
  # Runs interactively by default — deliver renders an HTML summary and waits for
  # confirmation. Pass force:true to skip that prompt in CI.
  desc "Push the privacy-policy URL to the App Store listing (metadata only, no binary)"
  lane :metadata do |options|
    api_key = ios_api_key

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    locales = info.get_app_info_localizations.map(&:locale)
    UI.important("Setting privacy_policy_url on: #{locales.join(', ')}")

    deliver(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      privacy_url: locales.to_h { |l| [l, PRIVACY_POLICY_URL] },
      # everything below keeps this to a metadata-only, non-destructive change
      skip_binary_upload: true,
      skip_screenshots: true,
      sync_screenshots: false,
      skip_app_version_update: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: options[:force] == true || options[:force] == "true",
    )
  end
end
